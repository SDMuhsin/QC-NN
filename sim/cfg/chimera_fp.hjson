// Snitch cluster configuration mirroring the cluster that chimera (tag
// CONVOLVE-TO) instantiates in hw/chimera_cluster.sv, for the standalone
// snitch_cluster testbench (target/snitch_cluster).
//
// Taken 1:1 from chimera_cluster.sv / chimera_pkg.sv:
//   9 cores (8 compute + 1 DMA, Xdma on the last core), 1 hive
//   TCDM 1024 x 16 banks x 64 bit = 128 KiB, zero-mem 64 KiB, periph 64 KiB
//   narrow 64 bit, wide (DMA) 512 bit = 32 bit * MemIslNarrowToWideFactor 16
//   addr 48 bit, user 2 bit (cheshire AxiUserWidth)
//   icache 2 sets x 16 lines x 256 bit = 1 KiB
//   DMANumAxInFlight 3, DMAReqFifoDepth 3, Narrow/Wide MaxTrans 4 (defaults)
//   RegisterCore{Req,Rsp}/RegisterOffload{Req,Rsp} = 1, everything else default
//   VMSupport 0, DebugSupport 1 (default), alias region off (default)
//
// Deliberate deviation (see sim/README.md): chimera leaves RVF/RVD/Xssr/Xfrep
// at the snitch_cluster defaults (0), i.e. its cluster is integer-only. All
// upstream DNN/BLAS kernels need FPU+SSR+FREP, so this config keeps the
// upstream default compute-core template (rv32imafd + SSR + FREP + SIMD FP).
// Use chimera_int.hjson for the bit-exact integer-only cluster.
{
    nr_s1_quadrant: 1,
    s1_quadrant: { nr_clusters: 1 },

    cluster: {
        // Testbench memory map (not chimera's SoC map; standalone TB only)
        boot_addr: 4096,               // 0x1000
        cluster_base_addr: 268435456,  // 0x1000_0000
        cluster_base_offset: 0,
        cluster_base_hartid: 0,
        addr_width: 48,
        data_width: 64,
        user_width: 2,
        tcdm: { size: 128, banks: 16 },
        cluster_periph_size: 64,
        zero_mem_size: 64,
        alias_region_enable: false,
        dma_data_width: 512,
        dma_axi_req_fifo_depth: 3,
        dma_req_fifo_depth: 3,
        narrow_trans: 4,
        wide_trans: 4,
        dma_user_width: 2,
        enable_debug: true,
        vm_support: false,
        sram_cfg_expose: true,
        sram_cfg_fields: { ema: 3, emaw: 2, emas: 1 },
        timing: {
            lat_comp_fp32: 2,
            lat_comp_fp64: 3,
            lat_comp_fp16: 1,
            lat_comp_fp16_alt: 1,
            lat_comp_fp8: 1,
            lat_comp_fp8_alt: 1,
            lat_noncomp: 1,
            lat_conv: 2,
            lat_sdotp: 3,
            fpu_pipe_config: "BEFORE",
            narrow_xbar_latency: "CUT_ALL_PORTS",
            wide_xbar_latency: "CUT_ALL_PORTS",
            register_core_req: true,
            register_core_rsp: true,
            register_offload_req: true,
            register_offload_rsp: true,
            register_fpu_req: false,
            register_ext_narrow: false,
            register_ext_wide: false
        },
        hives: [
            {
                icache: { size: 1, sets: 2, cacheline: 256 },
                cores: [
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/compute_core_template" },
                    { $ref: "#/dma_core_template" },
                ]
            }
        ]
    },
    dram: { address: 2147483648, length: 2147483648 },
    peripherals: { clint: { address: 4294901760, length: 4096 } },

    compute_core_template: {
        isa: "rv32imafd",
        xssr: true,
        xfrep: true,
        xdma: false,
        xf16: true,
        xf16alt: true,
        xf8: true,
        xf8alt: true,
        xfdotp: true,
        xfvec: true,
        ssr_nr_credits: 4,
        num_int_outstanding_loads: 1,
        num_int_outstanding_mem: 4,
        num_fp_outstanding_loads: 4,
        num_fp_outstanding_mem: 4,
        num_sequencer_instructions: 16,
        num_dtlb_entries: 1,
        num_itlb_entries: 1,
        ssr_intersection: true,
        ssr_intersection_triple: [0, 1, 2],
        ssrs: [ {indirection: true}, {indirection: true}, {} ],
    },
    dma_core_template: {
        isa: "rv32imafd",
        xdma: true,
        xssr: false,
        xfrep: false,
        xf16: false,
        xf16alt: false,
        xf8: false,
        xf8alt: false,
        xfdotp: false,
        xfvec: false,
        num_int_outstanding_loads: 1,
        num_int_outstanding_mem: 4,
        num_fp_outstanding_loads: 4,
        num_fp_outstanding_mem: 4,
        num_sequencer_instructions: 16,
        num_dtlb_entries: 1,
        num_itlb_entries: 1,
    }
}
