+    qc_csrw(1053, mult[9]);
+    qc_csrw(1054, mult[10]);
+    qc_csrw(1055, mult[11]);
+    qc_csrw(1056, mult[12]);
+    qc_csrw(1057, mult[13]);
+    qc_csrw(1058, mult[14]);
+    qc_csrw(1059, mult[15]);
+    qc_csrw(1110, shift[2]);
+    qc_csrw(1111, shift[3]);
+    if (groups <= 2) return;
+    qc_csrw(1060, mult[16]);
+    qc_csrw(1061, mult[17]);
+    qc_csrw(1062, mult[18]);
+    qc_csrw(1063, mult[19]);
+    qc_csrw(1064, mult[20]);
+    qc_csrw(1065, mult[21]);
+    qc_csrw(1066, mult[22]);
+    qc_csrw(1067, mult[23]);
+    qc_csrw(1112, shift[4]);
+    qc_csrw(1113, shift[5]);
+    if (groups <= 3) return;
+    qc_csrw(1068, mult[24]);
+    qc_csrw(1069, mult[25]);
+    qc_csrw(1070, mult[26]);
+    qc_csrw(1071, mult[27]);
+    qc_csrw(1072, mult[28]);
+    qc_csrw(1073, mult[29]);
+    qc_csrw(1074, mult[30]);
+    qc_csrw(1075, mult[31]);
+    qc_csrw(1114, shift[6]);
+    qc_csrw(1115, shift[7]);
+    if (groups <= 4) return;
+    qc_csrw(1076, mult[32]);
+    qc_csrw(1077, mult[33]);
+    qc_csrw(1078, mult[34]);
+    qc_csrw(1079, mult[35]);
+    qc_csrw(1080, mult[36]);
+    qc_csrw(1081, mult[37]);
+    qc_csrw(1082, mult[38]);
+    qc_csrw(1083, mult[39]);
+    qc_csrw(1116, shift[8]);
+    qc_csrw(1117, shift[9]);
+    if (groups <= 5) return;
+    qc_csrw(1084, mult[40]);
+    qc_csrw(1085, mult[41]);
+    qc_csrw(1086, mult[42]);
+    qc_csrw(1087, mult[43]);
+    qc_csrw(1088, mult[44]);
+    qc_csrw(1089, mult[45]);
+    qc_csrw(1090, mult[46]);
+    qc_csrw(1091, mult[47]);
+    qc_csrw(1118, shift[10]);
+    qc_csrw(1119, shift[11]);
+    if (groups <= 6) return;
+    qc_csrw(1092, mult[48]);
+    qc_csrw(1093, mult[49]);
+    qc_csrw(1094, mult[50]);
+    qc_csrw(1095, mult[51]);
+    qc_csrw(1096, mult[52]);
+    qc_csrw(1097, mult[53]);
+    qc_csrw(1098, mult[54]);
