 #define TEMPORAL_LOOP_BOUND (SIMD_SHARED_MULTIPLIER7 + 1)
 #define BYPASS_SIMD (TEMPORAL_LOOP_BOUND + 1)
 
-#define GEMMX_START (BYPASS_SIMD + 1)
-#define GEMMX_BUSY (GEMMX_START + 1)
-#define GEMMX_PERFORMANCE_COUNTER (GEMMX_BUSY + 1)
+// qcacc (QC-GeMMX): the per-output-channel requant table (81 CSRs, qcacc/hw/chisel/qcgemm/
+// QcRequantTable.scala) sits between BYPASS_SIMD and GEMMX_START.  Addresses from QC_RQ_MAP on are
+// beyond the csrw_ss / csrr_ss switch of snRuntime's csr.h (<= 1063): literal csrw / csrr below.
+#define QC_RQ_MAP 1043
+#define QC_RQ_MULT0 1044
+#define QC_RQ_SHIFT0 1108
+#define GEMMX_START 1124
+#define GEMMX_BUSY 1125
+#define GEMMX_PERFORMANCE_COUNTER 1126
+_Static_assert(QC_RQ_MAP == BYPASS_SIMD + 1 && QC_RQ_SHIFT0 == QC_RQ_MULT0 + 64 &&
+               GEMMX_START == QC_RQ_SHIFT0 + 16, "QC-GeMMX CSR map");
+#define QC_STR_(x) #x
+#define QC_STR(x) QC_STR_(x)
+#ifdef __riscv
+#define qc_csrw(addr, v) asm volatile("csrw " QC_STR(addr) ", %0" ::"r"((uint32_t)(v)))
+#define qc_csrr(addr) ({ uint32_t __t; asm volatile("csrr %0, " QC_STR(addr) : "=r"(__t)); __t; })
+#else   // host builds (nn/sw/native): the snrt.h stand-ins
+#define qc_csrw(addr, v) csrw_ss(addr, v)
+#define qc_csrr(addr) csrr_ss(addr)
+#endif
+// QC_RQ_MAP word: enable | mod (groups) | stride (D tiles per group step)
+#define QC_RQ_MAP_WORD(en, mod, stride) (((uint32_t)(en) << 31) | ((uint32_t)(mod) << 16) | (uint32_t)(stride))
+// program the table: map word, mult[8 * groups], packed shifts shift[2 * groups] (groups <= 8)
+void set_gemmx_qc_rq(uint32_t map, const int32_t* mult, const uint32_t* shift, uint32_t groups);
 
 // Pack matrix size setting to one CSR
