# R34 preset (results/r34.md): every fix of R29-R33 for the hub qb_hub, opt-in.  Sourced by impl/r34/run34.sh; without
# it every script keeps its default (byte-identical).  Needs R34 (the impl/r34 dir) set to this directory.
# R26 netlist + R28 hub settings come from impl/r28/run28.sh (QB_SYN r26_ptr = QB_TOP_PTR 1, QB9_W r26_w, pn2, QB_SB 649).
export QB_SYN=${QB_SYN:-r26_ptr} QB_SB=${QB_SB:-649}
# 1. GRT capacity (R30): pin-access layers M2 / M3 derated 0.6, M5-M9 0.10
export QB15_GADJ_L="M5-M9 0.10 M2-M3 0.6"
# 2. antenna (R29 / R31): dio step = pdn29 macro-strap trim + buf31 macro-input buffers (dio_pre.tcl) + diodes;
#    LEF-rule check antd29 (run31.sh antd)
#    QB34_ANT_EARLY 1 instead makes the pdn29 / buf31 edits before the GRT (route_pre.tcl; then R31_PDN "")
export QB34_ANT_EARLY=${QB34_ANT_EARLY:-0}
export R31_PDN=${R31_PDN-$R34/dio_pre.tcl} R31_BHPWL=300 R29_HPWL=1000 R29_SHPWL=1500 R29_DIO_PFX=r34_dio_
# 3. netlist / SDC / SPEF: EMA case-analysis regexp (R31), unescaped conn names in the PT SPEF (R31), OpenROAD SPEF
#    readable (R32 sec. 5.2: escaped CTS names kept, pinless nets skipped; flow def2spef.py)
export QB31_SDC=1 QC_SPEF_UNESC=1 QC_SPEF_ORFIX=1
# 4. IO latency L measured on the run's own cts db (route_pre.tcl -> <run>/r34_L.txt; run34.sh exports it to the later
#    steps), and one setup pass after the hold legalisation (R32)
export QB34_LAT=1 QB_RT_LOOPS=1
# 5. post-GRT setup repair at global-route parasitics, IO max delays relaxed during it (post_grt.tcl, R33 defect 1;
#    no hold repair there, as R33 r33_fx)
export QB34_GRTREP=1 QB34_GRT_TNS=100 QB34_GRT_IOFP=1 QB34_GRT_HOLD=${QB34_GRT_HOLD:-0}
# 6. clumped repeater pairs collapsed before CTS (cts_pre.tcl, R33 defect 2)
export QB34_COLL=1 QB34_COLL_D=10
# 7. repair_clock_nets with CK cells only (cts_pre.tcl, R33 defect 3)
export QB34_CKFIX=1
# hooks of the prod step (impl/r22/run.sh QB22_SET_X: later pairs override the R21 hooks)
export QB22_SET_X="PRE_CTS_TCL $R34/cts_pre.tcl PRE_ROUTE_TCL $R34/route_pre.tcl POST_GRT_TCL $R34/post_grt.tcl"
