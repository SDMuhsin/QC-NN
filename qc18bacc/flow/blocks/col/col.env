# Column block qb_col_blk: parameters of blocks/col/run.sh (ICC2 flow; the chip PG grid is floorplan/pg_grid.tcl).
COL_SYN=qb_col_blk_r5d_s20_tt_p1.65_topo   # DC netlist tag ($B/syn/<tag>: R5d netlist)
COL_PERIOD=6.5                             # clock period (ns) of P&R (ICC2 SDC, QB_PNR_PERIOD) and sign-off (PT, ETMs,
                                           # QC_PERIOD): one value (R79, PI decision: the R5b..R78 5.0 ns P&R override made
                                           # ICC2's IO hold / setup decisions differ from PrimeTime's; no margin)
COL_TOP=qb_col_blk                         # block top (DC netlist module)
COL_REFLEF=$B/r5b_blk/qb_col_blk_ring.lef  # reference abstract: pin positions every neighbour was built against (r48 placed these)
COL_PIN_DEF=$B/icc2/col/pins_r5b.def       # its signal pins as the floorplan DEF ICC2 reads (icc2.cfg), written by run.sh pnr
                                           # (floorplan/abstract_pins.py, R72; was pins_r48.def from r59's DEF, lost with tau5)
