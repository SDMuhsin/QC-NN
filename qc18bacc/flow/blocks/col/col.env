# Column block qb_col_blk: parameters of blocks/col/run.sh (ICC2 flow; the chip PG grid is floorplan/pg_grid.tcl).
COL_SYN=qb_col_blk_r5d_s20_tt_p1.65_topo   # DC netlist tag ($B/syn/<tag>: R5d netlist)
COL_PNR_PERIOD=5.0                         # P&R period (ns)
COL_PT_PERIOD=6.5                          # sign-off period (ns): PT, ETMs
COL_TOP=qb_col_blk                         # block top (DC netlist module)
COL_PIN_DEF=$B/icc2/col/pins_r48.def  # floorplan facts read by ICC2 (icc2.cfg): pin positions of the r48 column
                                       # (R62: header + PINS of r59/out/qb_col_blk.def.gz, which kept them fixed; pnr/r48_col is gone)
