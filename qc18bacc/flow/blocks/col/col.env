# Column block qb_col_blk: parameters of blocks/col/run.sh (ICC2 flow; the chip PG grid is floorplan/pg_grid.tcl).
COL_SYN=qb_col_blk_r5d_s20_tt_p1.65_topo   # DC netlist tag ($B/syn/<tag>: R5d netlist)
COL_PERIOD=6.5                             # clock period (ns) of P&R (ICC2 SDC, QB_PNR_PERIOD) and sign-off (PT, ETMs,
                                           # QC_PERIOD): one value (R79, PI decision: the R5b..R78 5.0 ns P&R override made
                                           # ICC2's IO hold / setup decisions differ from PrimeTime's; no margin)
COL_TOP=qb_col_blk                         # block top (DC netlist module)
COL_REFLEF=$B/r5b_blk/qb_col_blk_ring.lef  # reference abstract: pin positions every neighbour was built against (r48 placed these)
                                           # origin: abstract LEF of the retired OpenROAD column run r5b, an input with no producer in this flow (R92 [M] md5 1fe3173782d17e18b27b20e5aab08457, 12,354 signal pins; abstract_pins.py logs both)
                                           # its signal pins: the floorplan DEF <run>/pins.def ICC2 reads (icc2.cfg), written by
                                           # run.sh blk_pre_pnr (floorplan/abstract_pins.py, R72; R99: per run, was
                                           # $B/icc2/col/pins_r5b.def shared by every run of the host)
# P&R guard-bands (icc2/init.tcl qb_guard, R92; sign-off never changes): QC_PNR_GUARD_HOLD ns added to the SDC hold
# uncertainty, QC_PNR_GUARD_TRAN fraction off the design max_transition.  The values of every production run (col) and of
# the regression reference (rgr); an environment value overrides them (experiments; run.sh exports them)
QC_PNR_GUARD_HOLD=${QC_PNR_GUARD_HOLD:-0.010}
QC_PNR_GUARD_TRAN=${QC_PNR_GUARD_TRAN:-0.05}
