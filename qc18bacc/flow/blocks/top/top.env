# Chip top qb_chip: parameters of blocks/top/run.sh (production values of r43_a, results/r43.md, with the R46 opt-ins
# of results/r46.md; was /tmp/ckp908/r43_env_a.sh + impl/r39/run39.sh / r36/run36.sh defaults).
TOP_SYN=r35_ptr                    # DC chip run $B/syn/<tag>: PT run.env (QC_EXTRA_DB_<C>); its SDC is copied to <run>/qb_chip_pnr.sdc (unused)
TOP_PERIOD=6.5                     # clock period (ns): P&R and PT
# block views (run.sh views; OpenROAD reads TOP_ABS, the act ETMs from TOP_ETMO)
TOP_ABS=$B/r43/abs7                # LEF + ETM (OR copy, *_insfix for the columns) + PT dbs of the three hard blocks
TOP_ETMO=$B/r43/abs7_etmo          # act ETMs without output-pin checks for OpenROAD only (R46; PT keeps the originals)
TOP_ACT=$B/r39/act38               # act block outputs: qb_act2_blk_ant_ring.lef, qb_act2_blk_<c>.lib / _lib.db (r38_act_rr2)
TOP_HUB=$B/r43/hub40               # hub block outputs: qb_hub_ant_ring.lef, qb_hub_<c>.lib / _lib.db (r40_hub)
TOP_COL_ABS=$B/r36/abs4            # column ring LEF + insertion ETMs *_ins.lib / *_insfix.lib (R36 run36.sh abs, results/r36.md)
TOP_COL_ETM=$B/r36/in/colb/etm     # column raw ETMs + PT dbs (ss / ff used as they are)
TOP_COL_PTFIX=$B/r43/ptfix         # corrected column tt PT db (signoff/etm/etm_db.sh)
# floorplan (results/r39.md "W channel", CH = 700 um): X0 = 900 + CH, hub at HUBX = 40 + CH, die 4030 + CH wide
TOP_X0=1600                        # x of column 0 (um)
TOP_HUBX=740                       # x of the hub (um)
TOP_NB=800                         # north band height above the array (um)
TOP_PGBB="740 0 4730 1950.8"       # hub bbox (um): PSM-0038 islands inside it are tolerated by the fp power-grid check
# clock: block insertion delays (PT-measured tt, ns) and the initial chip IO latency L (re-measured after CTS and at GRT)
TOP_INS_COL=1.035
TOP_INS_HUB=1.571
TOP_INS_ACT=0.985
TOP_IO_LAT=4.54
TOP_GADJ_L="M2-M3 0.6"             # per-layer GRT adjustment (route/gadj_layers.tcl)
# post-GRT hold / antenna repair inside pnr (route/top_post_grt.tcl).  r43_a was routed with 1 / 1 (r43_a_chain.sh) and
# re-routed from route with 0 / 0 + the hold step (r43_a_chain2.sh).
TOP_GRTHOLD=1
TOP_GRTANT=1
