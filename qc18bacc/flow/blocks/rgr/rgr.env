# Regression block: parameters of blocks/rgr/run.sh (one PPU lane qb_lane_n; the column's flow on a design that runs in
# minutes, flow/README.md "Regression block").
RGR_SYN=rgr_lane_tt_p2.0_topo         # DC netlist tag ($B/syn/<tag>: synth/run.sh rgr, DC topographical tt at 2.0 ns)
RGR_PERIOD=2.5                        # clock period (ns) of P&R and sign-off (one value, as the column's COL_PERIOD)
RGR_TOP=qb_lane_n                     # block top (DC netlist module)
RGR_DIE="130 130"                     # die width height (um), origin 0 0; core 5 um inside (icc2.cfg)
# pins (no reference abstract): floorplan/edge_pins.py <netlist> <top> <die> <layer pitch offset width depth step>
# writes the pin-only abstract <run>/pins.lef (inputs west, outputs east, on M3 tracks y = 0.2 k: kit LEF OFFSET 0, gated
# by the floorplan track check; 0.1 x 0.52 um like the column's pins, 5 tracks apart), floorplan/abstract_pins.py its
# floorplan DEF <run>/pins.def (run.sh blk_pre_pnr)
RGR_PINS="M3 0.2 0.0 0.1 0.52 5"
# P&R guard-bands (icc2/init.tcl qb_guard, R92; sign-off never changes): QC_PNR_GUARD_HOLD ns added to the SDC hold
# uncertainty, QC_PNR_GUARD_TRAN fraction off the design max_transition.  The values of every production run (col) and of
# the regression reference (rgr); an environment value overrides them (experiments; run.sh exports them)
QC_PNR_GUARD_HOLD=${QC_PNR_GUARD_HOLD:-0.010}
QC_PNR_GUARD_TRAN=${QC_PNR_GUARD_TRAN:-0.05}
# ICC2 cores (R110, PI decision): 1, so the regression is run-to-run repeatable (icc2/common.tcl [M]: 1-core runs give an
# identical layout, multi-core ones do not) and common/regress.sh compares the route netlist / DEF md5 too; the block's
# default ahead of common/env.sh's 16 (run.sh sources this file first); an environment value overrides it, which the
# regression's knobs check fails
QB_ICC2_CORES=${QB_ICC2_CORES:-1}
