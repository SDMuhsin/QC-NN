# South hub block qb_hub: parameters of blocks/hub/run.sh (production values of the r35_hubC -> r38_hub_rr -> r40_hub
# lineage: impl/r34/preset.env + the impl/r31 / r28 / r22 defaults it ran with, results/r34.md .. r40.md).
HUB_SYN=r26_ptr                     # DC netlist tag ($B/syn/<tag>/run.env: PT macro .db list); QB_SYN of every step
HUB_W=$B/r26_w                      # partition work dir: qb_hub_c.v, bnd_bits.txt, per-run SDC / IO budget cfg_<tag>/
HUB_COLLEF=$B/r5b_blk/qb_col_blk.lef  # column abstract: the hub's north-edge pins sit straight below its south pins
HUB_PERIOD=6.5                      # P&R and sign-off period (ns): SDC, PT, ETMs
HUB_SB=649                          # logic band height (um) of the floorplan: die 3990 x 1950.8
HUB_GADJ_L="M5-M9 0.10 M2-M3 0.6"   # per-layer GRT adjustment (route/gadj_layers.tcl, diode step)
HUB_DPL_ARGS="-max_displacement 500"  # detailed_placement args of the P&R steps (the hold ECOs legalise without a limit)
HUB_SSX=$B/pnr/r35_hubC/r37_ssx_ports.txt  # hold step: per-port extra tightening "in|out <port> <X ns>" (R37 ssx, ss-derived)
HUB_SRAM_ABS=$B/drc/r38_hub         # signoff: SRAM abstract GDS sram_abs.gds + LVS stubs sram_stub.spi (lef2gds.py / lefstub.py, R38)
