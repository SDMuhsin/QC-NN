# Act block qb_act2_blk: parameters of blocks/act/run.sh (production values of r35_act -> r38_act_rr2, results/r35.md,
# r37.md, r38.md).  Exported by run.sh under the env names the configs / hooks read (in brackets).
ACT_SYN=r35_act                              # DC netlist tag ($B/syn/<tag>) [QB_SYN]
ACT_COLPINS=$B/r35/col_act_pins.txt          # column 0's act pin table (floorplan/act_pins.tcl, abutment check) [QB7_COLPINS]
ACT_YOFF=1140                                # block y = chip column y - ACT_YOFF (3110 - die height 1970) [QB7_YOFF]
ACT_PNR_PERIOD=5.0                           # P&R period (ns): SDC rescale (pnr), cts.sdc period (postcts) [QB_PNR_PERIOD]
ACT_PT_PERIOD=6.5                            # sign-off period (ns): PT, ETMs, hold ECOs [QB_PT_PERIOD, QC_PERIOD, QB35_PER]
ACT_MAXTRAN=0.30                             # P&R max transition (ns) appended to the P&R SDC, DRV repair limit [QB7_MAXTRAN, QB_DRV_SLEW]
ACT_MAXFO=32                                 # P&R max fanout appended to the P&R SDC [QB7_MAXFO]
ACT_DPL="-max_displacement {200 200}"        # detailed_placement options of pnr / postcts (hold ECOs: none) [QB7_DPL_ARGS]
ACT_RT_LOOPS=1                               # post-CTS setup / hold repair loops (repair/post_cts.tcl) [QB_RT_LOOPS]
ACT_GADJ_L="M2-M3 0.6"                       # per-layer GRT adjustment (route, hold ECOs, reroute) [QB15_GADJ_L]
ACT_AOUT=0.25                                # sign-off act output budget (fraction of P; P&R used the default 0.10) [QB7_AOUT]
ACT_DIN=0.74                                 # sign-off s_q / m_q input budget (P&R used the default 0.70) [QB7_DIN]
ACT_HOLD_M=0.03                              # hold step repair margin (ns) [QB35_HOLD_M]
# reroute step (R38 F4 fix; launch env NOT recorded, these are route/reroute.tcl's defaults; r45 replays used QB38_RR_MIN 1)
ACT_RR_DB=eco                                # db the copy run loads (eco | finish) [QB38_RRDB]
ACT_RR_MIN=0                                 # 1: delete the loaded copy db, save only finish [QB38_RR_MIN]
